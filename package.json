{
  "name": "ai-agent-platform",
  "private": true,
  "version": "1.0.0",
  "description": "An AI-first engineering platform for orchestrating intelligent workflows",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:core": "node --import tsx --test tests/core/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.0.4",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "rimraf": "^5.0.5"
  },
  "packageManager": "pnpm@10.26.1"
}
