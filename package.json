{
  "name": "ai-agent-platform",
  "private": true,
  "version": "1.0.0",
  "description": "An AI-first engineering platform for orchestrating intelligent workflows",
  "scripts": {
    "build": "tsc -b --force",
    "start": "tsx apps/api/src/index.ts",
    "dev": "tsx apps/api/src/index.ts",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:core": "node --import tsx --test tests/core/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/**/*.test.ts",
    "lint": "bash scripts/lint-templates.sh"
  },
  "devDependencies": {
    "@ai-agent-platform/ai": "*",
    "@ai-agent-platform/core": "*",
    "@ai-agent-platform/fan-tracker": "*",
    "@ai-agent-platform/health": "*",
    "@ai-agent-platform/integrations": "*",
    "@ai-agent-platform/pr-monitor": "*",
    "@ai-agent-platform/shared": "*",
    "@ai-agent-platform/skills": "*",
    "@ai-agent-platform/tools": "*",
    "@ai-agent-platform/umamusume": "*",
    "turbo": "^2.0.4",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "rimraf": "^5.0.5"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/domains/*"
  ]
}
